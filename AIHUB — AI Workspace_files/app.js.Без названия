  function enhanceNativeSelects() {
    $$('.setting-row select:not([data-enhanced])').forEach(select => {
      select.dataset.enhanced = 'true';
      select.classList.add('native-select-enhanced');
      const wrapper = document.createElement('div');
      wrapper.className = 'custom-select';
      select.parentNode.insertBefore(wrapper, select);
      wrapper.append(select);
      const trigger = document.createElement('button');
      trigger.className = 'custom-select-trigger';
      trigger.type = 'button';
      trigger.setAttribute('aria-expanded', 'false');
      trigger.innerHTML = `<span>${escapeHtml(select.options[select.selectedIndex].text)}</span><i data-lucide="chevron-down"></i>`;
      const menu = document.createElement('div');
      menu.className = 'custom-select-menu';
      menu.hidden = true;
      menu.innerHTML = [...select.options].map(option => `<button class="custom-select-option ${option.selected ? 'active' : ''}" type="button" data-select-value="${escapeHtml(option.value)}">${escapeHtml(option.text)}${option.selected ? '<i data-lucide="check"></i>' : ''}</button>`).join('');
      wrapper.append(trigger, menu);
    });
    icons();
  }

  function showView(name) {
    const target = $(`[data-view="${name}"]`);
    if (!target) return;
    state.view = name;
    $$('.app-view').forEach(view => view.classList.toggle('active', view === target));
    $$('.side-nav-link').forEach(link => link.classList.toggle('active', link.dataset.viewLink === name));
    $$('.top-nav-link').forEach(link => link.classList.toggle('active', link.dataset.viewLink === name));
    closeSidebar();
    closePopovers();
    if (name === 'history') renderHistory();
    history.replaceState(null, '', `#${name}`);
  }

  function showToast(message, icon = 'check') {
    const toast = $('#toast');
    toast.innerHTML = `<i data-lucide="${icon}"></i><span>${escapeHtml(message)}</span>`;
    icons();
    toast.classList.add('visible');
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(() => toast.classList.remove('visible'), 2200);
  }

  async function copyText(value, successMessage) {
    if (!value) return;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }
      showToast(successMessage, 'copy');
    } catch (error) {
      showToast('Не удалось скопировать', 'circle-alert');
    }
  }

  async function generateApiKey() {
    const button = $('#generate-api-key');
    const value = $('#api-key-value');
    const copyButton = $('#copy-api-key');
    const note = $('#api-key-note');
    if (!button || button.disabled) return;

    button.disabled = true;
    button.classList.add('is-loading');
    button.innerHTML = '<i data-lucide="loader-circle"></i><span>Выпускаю ключ</span>';
    icons();
    try {
      const response = await fetch('api/key.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': appConfig.csrfToken || '' },
        body: '{}'
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.key) throw new Error(data.error || 'Не удалось выпустить ключ');

      value.textContent = data.key;
      value.dataset.copyValue = data.key;
      value.classList.add('revealed');
      copyButton.disabled = false;
      copyButton.title = 'Скопировать API-ключ';
      note.textContent = 'Скопируйте ключ сейчас: после обновления страницы полный секрет больше не будет показан.';
      button.innerHTML = '<i data-lucide="refresh-cw"></i><span>Выпустить новый ключ</span>';
      showToast('API-ключ создан', 'key-round');
    } catch (error) {
      button.innerHTML = '<i data-lucide="refresh-cw"></i><span>Повторить выпуск ключа</span>';
      showToast(error.message || 'Не удалось выпустить ключ', 'circle-alert');
    } finally {
      button.disabled = false;
      button.classList.remove('is-loading');
      icons();
    }
  }


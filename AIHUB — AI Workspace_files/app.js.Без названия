    const modal = $('#subscription-modal');
    if (!modal || modal.hidden) return;
    modal.classList.remove('visible');
    clearTimeout(modal.hideTimer);
    modal.hideTimer = setTimeout(() => { modal.hidden = true; }, 320);
  }

  function setSidebar(open) {
    const sidebar = $('#sidebar');
    const backdrop = $('#mobile-backdrop');
    const button = $('#mobile-menu-button');
    sidebar.classList.toggle('open', open);
    backdrop.classList.toggle('visible', open);
    button.classList.toggle('is-active', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    button.innerHTML = `<i data-lucide="${open ? 'x' : 'menu'}"></i>`;
    icons();
  }

  function closeSidebar() { setSidebar(false); }
  function toggleSidebar() { setSidebar(!$('#sidebar').classList.contains('open')); }


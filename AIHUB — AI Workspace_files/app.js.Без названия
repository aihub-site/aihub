      if (!state.model.ratios.includes(state.filters.ratio)) state.filters.ratio = state.model.ratios[0];
      if (!state.model.duration.includes(Number(state.filters.duration))) state.filters.duration = state.model.duration[0];
      if (!state.model.quality.includes(state.filters.quality)) state.filters.quality = state.model.quality[0];
      container.innerHTML = filterControl('ratio', 'rectangle-horizontal', 'Формат', state.model.ratios) + filterControl('duration', 'timer', 'Длительность', state.model.duration, ' сек') + filterControl('quality', 'badge-check', 'Качество', state.model.quality);

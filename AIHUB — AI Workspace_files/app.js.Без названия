        </button>
        <div class="filter-menu" data-filter-menu="${key}" hidden>
          ${values.map(value => `<button class="${String(value) === String(current) ? 'active' : ''}" type="button" data-filter-value="${value}">${value}${suffix}${String(value) === String(current) ? '<i data-lucide="check"></i>' : ''}</button>`).join('')}
        </div>
      </div>`;
  }

  function renderFilters() {
    const container = $('#dynamic-filters');
    container.style.animation = 'none';
    void container.offsetWidth;
    container.style.animation = '';
    if (state.model.type === 'text') {
      if (!state.model.reasoning.includes(state.filters.reasoning)) state.filters.reasoning = state.model.reasoning[0];
      container.innerHTML = filterControl('reasoning', 'brain-circuit', 'Режим', state.model.reasoning);
    } else if (state.model.type === 'image') {
      if (!state.model.ratios.includes(state.filters.ratio)) state.filters.ratio = state.model.ratios[0];
      if (!state.model.quality.includes(state.filters.quality)) state.filters.quality = state.model.quality[0];
      container.innerHTML = filterControl('ratio', 'rectangle-horizontal', 'Формат', state.model.ratios) + filterControl('quality', 'badge-check', 'Качество', state.model.quality);

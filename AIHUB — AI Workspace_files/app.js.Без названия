  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
  const escapeHtml = value => String(value).replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
  const icons = () => window.lucide && window.lucide.createIcons({ attrs: { 'stroke-width': 1.8 } });

  function refreshLightbox() {
    if (!window.GLightbox) return;
    if (!mediaLightbox) {
      mediaLightbox = window.GLightbox({
        selector: '.media-lightbox',
        touchNavigation: true,
        closeOnOutsideClick: true,
        autoplayVideos: false,
        videosWidth: 'min(92vw, 1200px)',
        plyr: { config: { controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen'] } }
      });
    } else {
      mediaLightbox.reload();
    }
  }

  function openFallbackMediaViewer(link) {
    const viewer = $('#media-viewer');
    const stage = $('#media-viewer-stage');
    if (!viewer || !stage) return;
    const url = link.getAttribute('href');
    const isVideo = link.dataset.type === 'video';
    stage.innerHTML = isVideo
      ? `<video src="${escapeHtml(url)}" controls autoplay playsinline preload="metadata"></video>`
      : `<img src="${escapeHtml(url)}" alt="Результат генерации">`;
    const media = stage.firstElementChild;
    media?.addEventListener('error', () => {
      stage.innerHTML = '<div class="media-viewer-missing"><i data-lucide="file-plus-2"></i><span>Медиафайл ещё не загружен в проект</span></div>';
      icons();
    }, { once: true });
    viewer.hidden = false;
    requestAnimationFrame(() => viewer.classList.add('is-open'));
    document.body.classList.add('media-viewer-open');
    icons();
  }

  function closeFallbackMediaViewer() {
    const viewer = $('#media-viewer');
    if (!viewer || viewer.hidden) return;
    viewer.classList.remove('is-open');
    document.body.classList.remove('media-viewer-open');
    setTimeout(() => {
      if (viewer.classList.contains('is-open')) return;
      viewer.hidden = true;
      $('#media-viewer-stage').innerHTML = '';
    }, 220);
  }

  function fallbackOrientation(ratio = '1:1') {
    const [width, height] = String(ratio).split(':').map(Number);
    if (!width || !height) return 'square';
    if (width / height > 1.1) return 'landscape';
    if (width / height < 0.9) return 'portrait';
    return 'square';
  }

  function setMediaOrientation(container, width, height) {
    if (!container || !width || !height) return;
    const orientation = width / height > 1.1 ? 'landscape' : width / height < 0.9 ? 'portrait' : 'square';
    container.classList.remove('orientation-landscape', 'orientation-portrait', 'orientation-square');
    container.classList.add(`orientation-${orientation}`);
    const card = container.closest('.media-card');
    card?.classList.remove('orientation-landscape', 'orientation-portrait', 'orientation-square');
    card?.classList.add(`orientation-${orientation}`);
  }

  function bindResultMedia(root = document) {
    $$('[data-result-media]', root).forEach(media => {
      if (media.dataset.metadataBound === 'true') return;
      media.dataset.metadataBound = 'true';
      const container = media.closest('.media-result');
      const readyEvent = media.tagName === 'VIDEO' ? 'loadedmetadata' : 'load';
      const apply = () => setMediaOrientation(container, media.videoWidth || media.naturalWidth, media.videoHeight || media.naturalHeight);
      media.addEventListener(readyEvent, apply, { once: true });
      media.addEventListener('error', () => container?.classList.add('media-missing'), { once: true });
      if ((media.tagName === 'IMG' && media.complete && media.naturalWidth) || (media.tagName === 'VIDEO' && media.readyState >= 1)) apply();
    });
    refreshLightbox();
  }

  function readStoredState() {
    try { return JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch (error) { return {}; }
  }

  function persistState() {
    try {
      const chats = state.chats.map(chat => ({
        ...chat,
        messages: chat.messages.map(message => ({
          ...message,
          attachments: (message.attachments || []).map(({ name, type }) => ({ name, type }))
        }))
      }));
      localStorage.setItem(storageKey, JSON.stringify({ history: state.history, chats }));
    } catch (error) { /* Storage is optional for the demo. */ }
  }

  function modelClass(type) { return `${type}-model`; }
  function getModel(id) { return models.find(model => model.id === id) || models[0]; }

  const modelBrandAssets = Object.freeze({
    openai: 'openai.svg',
    anthropic: 'anthropic.svg',
    gemini: 'gemini.svg',
    google: 'google.svg',
    x: 'x.svg',
    bytedance: 'bytedance.svg',
    recraft: 'recraft.svg',
    flux: 'flux.svg',
    pixverse: 'pixverse.svg',
    kling: 'kling.svg'
  });

  function modelSymbolHtml(model) {
    const asset = modelBrandAssets[model.brand];
    if (asset) {
      const src = `assets/icons/models/${asset}`;
      return `<img src="${src}" alt="" class="model-brand-icon" onload="if(this.nextElementSibling)this.nextElementSibling.style.display='none';" onerror="this.style.display='none';"><i data-lucide="${model.icon}"></i>`;
    }
    return `<i data-lucide="${model.icon}"></i>`;
  }

  function openPopover(menu, trigger = null) {
    if (!menu) return;
    clearTimeout(menu.closeTimer);
    menu.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
    menu.closest('.custom-select')?.classList.add('open');
  }

  function closePopover(menu, trigger = null, immediate = false) {
    if (!menu || menu.hidden) return;
    clearTimeout(menu.closeTimer);
    menu.classList.remove('is-open');
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
    menu.closest('.custom-select')?.classList.remove('open');
    if (immediate) { menu.hidden = true; return; }
    menu.closeTimer = setTimeout(() => { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 290);
  }

  function closePopovers(except = null) {
    const menus = [$('#model-menu'), $('#profile-menu'), ...$$('[data-filter-menu]'), ...$$('.custom-select-menu')];
    menus.forEach(menu => {
      if (!menu || menu === except) return;
      const trigger = menu.id === 'model-menu'
        ? $('#model-trigger')
        : menu.id === 'profile-menu'
          ? $('#profile-trigger')
          : menu.matches('[data-filter-menu]')
            ? $(`[data-filter-trigger="${menu.dataset.filterMenu}"]`)
            : $('.custom-select-trigger', menu.closest('.custom-select'));
      closePopover(menu, trigger);
    });
  }

  function togglePopover(menu, trigger) {
    const willOpen = menu.hidden || !menu.classList.contains('is-open');
    closePopovers(willOpen ? menu : null);
    if (willOpen) openPopover(menu, trigger); else closePopover(menu, trigger);
  }

  function renderModelMenu() {
    const menu = $('#model-menu');
    const groups = ['Текст', 'Изображения', 'Видео'];
    menu.innerHTML = groups.map(group => `
      <div class="model-group">
        <div class="model-group-label">${group}</div>
        ${models.filter(model => model.group === group).map(model => `
          <button class="model-option ${model.id === state.model.id ? 'active' : ''}" type="button" data-model-id="${model.id}">
            <span class="model-symbol ${modelClass(model.type)}">${modelSymbolHtml(model)}</span>
            <span class="model-option-copy"><strong>${model.name}</strong><small>${model.description}</small></span>
            ${model.id === state.model.id ? '<i class="model-check" data-lucide="check"></i>' : ''}
          </button>`).join('')}
      </div>`).join('');
    icons();
  }

  function filterControl(key, icon, label, values, suffix = '') {
    const current = state.filters[key];
    return `
      <div class="filter-control" data-filter-control="${key}">
        <button class="filter-button" type="button" data-filter-trigger="${key}" aria-expanded="false">
